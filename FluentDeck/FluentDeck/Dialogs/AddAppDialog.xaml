<ContentDialog
    x:Class="FluentDeck.Dialogs.AddAppDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:labs="using:CommunityToolkit.WinUI.Controls"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Add App to Category"
    PrimaryButtonText="Add App"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    MinWidth="500">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">620</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="580" Width="480">
        <StackPanel Spacing="16" Margin="0,0,16,0">

            <!-- Duplicate warning -->
            <InfoBar x:Name="DuplicateWarningBar"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Warning"
                     AutomationProperties.AutomationId="DuplicateWarningBar"/>

            <!-- Duplicate app detail card -->
            <Border x:Name="DuplicateAppCard"
                    Visibility="Collapsed"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="4"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <Image x:Name="DuplicateAppLogoImage" Width="44" Height="44" Stretch="Uniform"
                               AutomationProperties.Name="Existing app logo"/>
                    </Border>

                    <!-- Details -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="DuplicateAppNameText"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <HyperlinkButton x:Name="DuplicateAppUrlButton"
                                         Padding="0" FontSize="11"
                                         AutomationProperties.Name="Existing app URL"/>
                        <!-- Badges -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border x:Name="DuplicateIndicatorBadge" CornerRadius="4" Padding="6,2"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock x:Name="DuplicateIndicatorText" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <Border x:Name="DuplicateFossBadge" CornerRadius="4" Padding="6,2"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="FOSS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <Border x:Name="DuplicatePaidBadge" CornerRadius="4" Padding="6,2"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="💰" FontSize="10"/>
                            </Border>
                            <Border x:Name="DuplicatePlannedBadge" CornerRadius="4" Padding="6,2"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="📆 Planned" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <Border x:Name="DuplicateDiscontinuedBadge" CornerRadius="4" Padding="6,2"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="❎ Discontinued" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- App Name -->
            <StackPanel Spacing="4">
                <TextBlock Text="App Name" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="NameInput" PlaceholderText="e.g. Files" HorizontalAlignment="Stretch" TextChanged="Input_TextChanged"
                         ToolTipService.ToolTip="Enter the name of the application"
                         AutomationProperties.AutomationId="NameInput"
                         AutomationProperties.Name="App Name"/>
            </StackPanel>

            <!-- App Source URL -->
            <StackPanel Spacing="4">
                <TextBlock Text="App Source URL" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="UrlInput" PlaceholderText="https://github.com/..." HorizontalAlignment="Stretch" TextChanged="UrlInput_TextChanged"
                         ToolTipService.ToolTip="Enter the homepage or repository URL of the application"
                         AutomationProperties.AutomationId="UrlInput"
                         AutomationProperties.Name="App Source URL"/>
            </StackPanel>

            <!-- Category -->
            <StackPanel Spacing="4">
                <TextBlock Text="Category" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="CategoryComboBox" SelectedIndex="0" IsEnabled="False" HorizontalAlignment="Stretch"
                          ToolTipService.ToolTip="Target category"
                          AutomationProperties.AutomationId="CategoryComboBox"
                          AutomationProperties.Name="Category">
                    <ComboBoxItem x:Name="CategoryItem" Content="Category Name"/>
                </ComboBox>
            </StackPanel>

            <!-- Logo URL + Preview -->
            <StackPanel Spacing="6">
                <TextBlock Text="Logo Image Link (Optional)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="LogoUrlInput" PlaceholderText="https://raw.githubusercontent.com/..." HorizontalAlignment="Stretch" TextChanged="LogoUrlInput_TextChanged"
                         ToolTipService.ToolTip="Enter raw link to logo image"
                         AutomationProperties.AutomationId="LogoUrlInput"
                         AutomationProperties.Name="Logo Image Link"/>
                <HyperlinkButton x:Name="LogoSuggestionLink" Visibility="Collapsed" Click="LogoSuggestionLink_Click" Padding="0"
                                 ToolTipService.ToolTip="Accept suggested raw repository URL"
                                 AutomationProperties.Name="Apply Suggested Logo URL">
                    <TextBlock x:Name="LogoSuggestionText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemAccentColor}" />
                </HyperlinkButton>
                <!-- Logo Preview -->
                <Border x:Name="LogoPreviewBorder" Visibility="Collapsed"
                        CornerRadius="4" Width="64" Height="64"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Image x:Name="LogoPreviewImage"
                           Width="56" Height="56"
                           Stretch="Uniform"
                           AutomationProperties.Name="Logo preview"/>
                </Border>
            </StackPanel>

            <!-- Design Language -->
            <StackPanel Spacing="4">
                <TextBlock Text="Design Language" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <labs:Segmented x:Name="IndicatorSegment" SelectedIndex="0" SelectionChanged="Input_TextChanged" HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Select target WinUI 3 design language indicator"
                                AutomationProperties.AutomationId="IndicatorSegment"
                                AutomationProperties.Name="Design Language">
                    <labs:SegmentedItem Content="WD"  Tag="WD"  HorizontalAlignment="Stretch" ToolTipService.ToolTip="WinUI 3 Design Only" />
                    <labs:SegmentedItem Content="WDM" Tag="WDM" HorizontalAlignment="Stretch" ToolTipService.ToolTip="WinUI 3 Design + Mica Material" />
                    <labs:SegmentedItem Content="WDA" Tag="WDA" HorizontalAlignment="Stretch" ToolTipService.ToolTip="WinUI 3 Design + Acrylic Material" />
                </labs:Segmented>
            </StackPanel>

            <!-- Pricing -->
            <StackPanel Spacing="4">
                <TextBlock Text="Pricing" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <labs:Segmented x:Name="PricingSegment" SelectedIndex="0" SelectionChanged="Input_TextChanged" HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Select application pricing model"
                                AutomationProperties.AutomationId="PricingSegment"
                                AutomationProperties.Name="Pricing">
                    <labs:SegmentedItem Content="Free"  Tag="Free"  HorizontalAlignment="Stretch" ToolTipService.ToolTip="Free application" />
                    <labs:SegmentedItem Content="FOSS"  Tag="FOSS"  HorizontalAlignment="Stretch" ToolTipService.ToolTip="Free and Open Source Software" />
                    <labs:SegmentedItem Content="Paid"  Tag="Paid"  HorizontalAlignment="Stretch" ToolTipService.ToolTip="Paid application" />
                </labs:Segmented>
            </StackPanel>

            <!-- Project State -->
            <StackPanel Spacing="4">
                <TextBlock Text="Project State" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <labs:Segmented x:Name="ProjectStateSegment" SelectedIndex="0" SelectionChanged="Input_TextChanged" HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Select developmental status"
                                AutomationProperties.AutomationId="ProjectStateSegment"
                                AutomationProperties.Name="Project State">
                    <labs:SegmentedItem Content="Active"       Tag="Active"       HorizontalAlignment="Stretch" ToolTipService.ToolTip="Active development" />
                    <labs:SegmentedItem Content="Planned"      Tag="Planned"      HorizontalAlignment="Stretch" ToolTipService.ToolTip="Planned or in-development progress" />
                    <labs:SegmentedItem Content="Discontinued" Tag="Discontinued" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Discontinued or paused indefinitely" />
                </labs:Segmented>
            </StackPanel>

            <!-- App Type -->
            <StackPanel Spacing="4">
                <TextBlock Text="App Type" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <labs:Segmented x:Name="TypeSegment" SelectedIndex="0" SelectionChanged="Input_TextChanged" HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Select entry catalog type"
                                AutomationProperties.AutomationId="TypeSegment"
                                AutomationProperties.Name="App Type">
                    <labs:SegmentedItem Content="App"        Tag="App"   HorizontalAlignment="Stretch" ToolTipService.ToolTip="Standard application" />
                    <labs:SegmentedItem Content="Theme (🎨)" Tag="Theme" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Styling theme" />
                </labs:Segmented>
            </StackPanel>

            <!-- Markdown Preview -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="PreviewHeaderTextBlock" Text="Markdown Preview" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- Before Preview (Shown in Edit Mode) -->
                <StackPanel x:Name="BeforePreviewContainer" Visibility="Collapsed" Spacing="2">
                    <TextBlock Text="BEFORE:" Style="{StaticResource CaptionTextBlockStyle}" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <TextBlock x:Name="BeforePreviewTextBlock" TextWrapping="Wrap" FontFamily="Consolas"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                    <TextBlock Text="AFTER:" Style="{StaticResource CaptionTextBlockStyle}" FontSize="10" Margin="0,4,0,0" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                </StackPanel>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                    <TextBlock x:Name="PreviewTextBlock" TextWrapping="Wrap" FontFamily="Consolas"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
