<Page
    x:Class="FluentDeck.Pages.Icons.IconsPage"
    x:Name="IconsPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:labs="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:FluentDeck.Controls"
    xmlns:local="using:FluentDeck.Pages.Icons"
    xmlns:viewmodels="using:FluentDeck.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <local:MonoStyleConverter x:Key="MonoStyleConverter"/>

        <DataTemplate x:Key="IconItemTemplate" x:DataType="viewmodels:IconItem">
            <Grid Padding="12" RowDefinitions="*,Auto" MinHeight="140" Height="140" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <controls:SvgImage SourcePath="{x:Bind ImagePath, Mode=OneWay}"
                                Width="48" Height="48"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Main Grid split into Left Pane and Sidebar Pane -->
    <Grid Padding="24,24,0,0" ColumnDefinitions="*,Auto">

        <!-- Left Pane (Search, Style Segmented, Grid) -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,16,0">

            <!-- Top Bar: search box + Style Segmented -->
            <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <AutoSuggestBox x:Name="SearchBox" Width="260" Height="32" PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                    QueryIcon="Find"
                                    TextChanged="SearchBox_TextChanged"
                                    AutomationProperties.AutomationId="IconSearchBox"
                                    AutomationProperties.Name="Search icons"
                                    VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Top Style Segmented (Regular, Filled, Color) -->
                <labs:Segmented Grid.Column="1" x:Name="TopStyleSegment" SelectedIndex="0" SelectionChanged="TopStyleSegment_SelectionChanged" Height="32" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="IconTopStyleSegment" AutomationProperties.Name="Icon Style">
                    <labs:Segmented.ItemContainerStyle>
                        <Style TargetType="labs:SegmentedItem">
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </labs:Segmented.ItemContainerStyle>
                    <labs:SegmentedItem Content="Regular" Tag="Regular" ToolTipService.ToolTip="Regular outlined Fluent icons"/>
                    <labs:SegmentedItem Content="Filled" Tag="Filled" ToolTipService.ToolTip="Solid filled Fluent icons"/>
                    <labs:SegmentedItem Content="Color" Tag="Color" ToolTipService.ToolTip="Vibrant multi-color Fluent icons"/>
                </labs:Segmented>
            </Grid>

            <!-- Divider -->
            <MenuFlyoutSeparator Grid.Row="1" />

            <!-- Content Frame for IconsGridPage with SlideNavigationTransitionInfo -->
            <Frame x:Name="ContentFrame" Grid.Row="2"
                   IsNavigationStackEnabled="False" />
        </Grid>

        <!-- Right Pane (Sidebar Details) -->
        <Border Grid.Column="1" Width="380" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="20,0,24,24">
            <Grid RowDefinitions="*,Auto">
                <!-- If No Icon is Selected -->
                <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{x:Bind local:IconsPage.NullToVisibility(ViewModel.SelectedIcon), Mode=OneWay}">
                    <FontIcon Glyph="&#xEC07;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="Select an icon to view details" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                </StackPanel>

                <!-- If Icon is Selected -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind local:IconsPage.NotNullToVisibility(ViewModel.SelectedIcon), Mode=OneWay}">
                    <StackPanel Spacing="16" Padding="0,0,0,0">
                        <!-- Preview Card with 1:1 Aspect Ratio container -->
                        <Border BorderThickness="1" Width="340" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                CornerRadius="8" 
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                Padding="20" HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                            <Grid RowDefinitions="*,Auto" RowSpacing="20">
                                <!-- Image area (fills top row) -->
                                <Grid Grid.Row="0" MinHeight="180">
                                    <Viewbox MaxWidth="180" MaxHeight="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="120" Height="120">
                                            <controls:SvgImage SourcePath="{x:Bind ViewModel.PreviewImagePath, Mode=OneWay}"
                                                            Width="120" Height="120"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Viewbox>
                                </Grid>

                                <!-- Representation Style Picker (bottom of card) -->
                                <labs:Segmented Grid.Row="1" x:Name="StyleSegment"
                                                SelectedIndex="0"
                                                SelectionChanged="StyleSegment_SelectionChanged"
                                                Height="32"
                                                AutomationProperties.AutomationId="IconPreviewStyleSegment" AutomationProperties.Name="Preview Style"
                                                HorizontalAlignment="Stretch">
                                    <labs:SegmentedItem x:Name="RegularStyleItem" Content="Regular" Tag="Regular"/>
                                    <labs:SegmentedItem x:Name="FilledStyleItem" Content="Filled" Tag="Filled"/>
                                    <labs:SegmentedItem x:Name="ColorStyleItem" Content="Color" Tag="Color"/>
                                </labs:Segmented>
                            </Grid>
                        </Border>

                        <!-- Size Picker (Outside Preview Card) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Size" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <labs:Segmented x:Name="SizeSegment"
                                            SelectedIndex="2"
                                            SelectionChanged="SizeSegment_SelectionChanged"
                                            Height="32"
                                            AutomationProperties.AutomationId="IconSizeSegment" AutomationProperties.Name="Icon Size"
                                            HorizontalAlignment="Stretch">
                                <labs:SegmentedItem x:Name="Size16Item" Content="16" Tag="16"/>
                                <labs:SegmentedItem x:Name="Size20Item" Content="20" Tag="20"/>
                                <labs:SegmentedItem x:Name="Size24Item" Content="24" Tag="24"/>
                                <labs:SegmentedItem x:Name="Size28Item" Content="28" Tag="28"/>
                                <labs:SegmentedItem x:Name="Size32Item" Content="32" Tag="32"/>
                                <labs:SegmentedItem x:Name="Size48Item" Content="48" Tag="48"/>
                            </labs:Segmented>
                        </StackPanel>

                        <!-- Detailed Metadata Grid -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Metadata Details" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            
                            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                                <!-- Row 0: Name -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SelectedIcon.Name, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>

                                <!-- Row 1: Tags -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tags" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind local:IconsPage.GetKeywordsString(ViewModel.SelectedIcon.Metaphors), Mode=OneWay}" VerticalAlignment="Center" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom-pinned Actions -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0"
                            Visibility="{x:Bind local:IconsPage.NotNullToVisibility(ViewModel.SelectedIcon), Mode=OneWay}">
                    <Button Click="CopySvg_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <ScaleTransform/>
                            </StackPanel.RenderTransform>
                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            <TextBlock Text="Copy SVG"/>
                        </StackPanel>
                    </Button>

                    <Button Content="Save as SVG..." Click="SaveImage_Click" HorizontalAlignment="Stretch" Padding="12,10">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                    <TextBlock Text="Save as SVG..."/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
