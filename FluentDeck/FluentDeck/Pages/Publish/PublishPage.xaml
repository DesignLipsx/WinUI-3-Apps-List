<Page
    x:Class="FluentDeck.Pages.Publish.PublishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,24,24,24" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Publish Changes to GitHub" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16" />

        <!-- Status InfoBar -->
        <InfoBar x:Name="PublishInfoBar" Grid.Row="0" Margin="0,48,0,0" IsOpen="False" Severity="Informational" VerticalAlignment="Top" />

        <!-- Main Content Area: Single Column Scrollable -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
            <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
                
                <!-- Scanning Indicator -->
                <StackPanel x:Name="ScanningSection" Spacing="8" HorizontalAlignment="Center" Margin="0,32">
                    <ProgressRing x:Name="ScanningRing" IsActive="True" Width="32" Height="32"/>
                    <TextBlock Text="Checking repository status..." Style="{ThemeResource BodyTextBlockStyle}"/>
                </StackPanel>

                <!-- Status & Changes Panel -->
                <StackPanel x:Name="RepositoryStatusPanel" Spacing="16" Visibility="Collapsed">
                    <!-- No Changes Message -->
                    <TextBlock x:Name="NoChangesText" Text="No local changes detected in README.md or apps_logo.yml. Your repository is already up to date with origin." 
                               Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <StackPanel x:Name="ChangesPanel" Spacing="16">
                        <TextBlock Text="Local Changes" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <!-- Modified Files Card -->
                        <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="4" Padding="16" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Modified Files" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="ModifiedFilesText" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Added Apps Checklist Card -->
                        <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="4" Padding="16" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Newly Added Apps" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="AddedAppsText" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" LineHeight="20"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Commit Settings Panel -->
                <StackPanel Spacing="16" x:Name="CommitPanel" Visibility="Collapsed">
                    <TextBlock Text="Publish Details" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Border BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="4" Padding="16" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <StackPanel Spacing="16">
                            <!-- Commit Message input -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Commit Message" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox x:Name="CommitMsgInput" PlaceholderText="e.g. Add AppName to list" HorizontalAlignment="Stretch" TextChanged="CommitMsgInput_TextChanged"
                                         ToolTipService.ToolTip="Write a description of the changes" AutomationProperties.Name="Commit Message"/>
                            </StackPanel>

                            <!-- Action Button -->
                            <Button x:Name="PublishBtn" Content="Sync &amp; Publish" Style="{StaticResource AccentButtonStyle}" 
                                    HorizontalAlignment="Stretch" Padding="0,10" Click="PublishButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom: Terminal Execution Console (Shown only when changes exist or during publishing) -->
        <Grid x:Name="TerminalConsoleGrid" Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8" Height="220" Visibility="Collapsed">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Execution Log Console" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Clear Log" Padding="8,4" Click="ClearLogButton_Click" VerticalAlignment="Center"/>
            </Grid>
            <Border Grid.Row="1" CornerRadius="8" Background="Black" Padding="12" BorderThickness="1" BorderBrush="#333333">
                <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="ConsoleScrollViewer">
                    <TextBlock x:Name="ConsoleOutput" FontFamily="Consolas, Courier New" FontSize="11" Foreground="#00FF00" TextWrapping="Wrap" Text="Console initialized. Ready to scan..."/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
